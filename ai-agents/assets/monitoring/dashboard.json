{
  "dashboard": {
    "title": "AI Agent Monitoring",
    "version": 1,
    "panels": [
      {
        "title": "LLM Requests / min",
        "type": "graph",
        "targets": [{
          "expr": "rate(llm_requests_total[1m])",
          "legendFormat": "requests"
        }]
      },
      {
        "title": "Latency P50/P95/P99",
        "type": "graph",
        "targets": [
          {"expr": "histogram_quantile(0.50, rate(llm_latency_seconds_bucket[5m]))", "legendFormat": "p50"},
          {"expr": "histogram_quantile(0.95, rate(llm_latency_seconds_bucket[5m]))", "legendFormat": "p95"},
          {"expr": "histogram_quantile(0.99, rate(llm_latency_seconds_bucket[5m]))", "legendFormat": "p99"}
        ]
      },
      {
        "title": "Cost ($/h)",
        "type": "graph",
        "targets": [{
          "expr": "rate(llm_cost_total[1h])",
          "legendFormat": "cost"
        }]
      },
      {
        "title": "Tool Calls by Type",
        "type": "piechart",
        "targets": [{
          "expr": "sum by (tool) (rate(agent_tool_calls_total[5m]))"
        }]
      },
      {
        "title": "Error Rate",
        "type": "stat",
        "targets": [{
          "expr": "rate(agent_errors_total[5m])"
        }]
      },
      {
        "title": "Guardrail Blocks",
        "type": "graph",
        "targets": [{
          "expr": "rate(agent_guardrail_blocks_total[5m])",
          "legendFormat": "blocks"
        }]
      }
    ]
  }
}
